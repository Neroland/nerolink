{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Server-side bridge for the NeroLink companion app: pair your phone in-game and see your Neroland base live - energy, quests, progression and more - over a pinned TLS connection or the NeroLink relay. Requires Neroland Core.",
  "contact": {
    "homepage": "https://neroland.co.za"
  },
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "nerolink_logo.png",
  "accessWidener": "nerolink.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": ["za.co.neroland.nerolink.fabric.NeroLinkFabric"],
    "client": ["za.co.neroland.nerolink.fabric.NeroLinkFabricClient"]
  },
  "mixins": [
    "nerolink-common.mixins.json",
    "nerolink.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "nerolandcore": ">=${nerolandcore_version} <2.0.0"
  }
}
